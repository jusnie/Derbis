# =============================================================================
# Derbis — Local Configuration & GitHub Actions Secrets Reference
# =============================================================================
# This file documents the configuration required to build and maintain Derbis.
#
# Local development:
#   Copy this file to the repository root as "local.properties" and complete the LOCAL CONFIGURATION
#   section.
#
# GitHub Actions:
#   Add the values listed under GITHUB ACTIONS REPOSITORY SECRETS in:
#   Repository Settings → Secrets and variables → Actions
#
# Never commit real API keys, cookies, passwords, keystores, or credentials.
# =============================================================================


# =============================================================================
# LOCAL CONFIGURATION
# =============================================================================

# YouTube Innertube
# -----------------------------------------------------------------------------
youtubeInnertubeApiKey=


# Android Release Signing
# -----------------------------------------------------------------------------
derbisStoreFile=app/derbis-release.jks
derbisStorePassword=
derbisKeyAlias=
derbisKeyPassword=


# =============================================================================
# GITHUB ACTIONS REPOSITORY SECRETS
# =============================================================================
# Reference only: these entries are read from GitHub repository secrets,
# not directly from local.properties.


# YouTube
# -----------------------------------------------------------------------------
# YOUTUBE_INNERTUBE_API_KEY=


# Editorial Catalog
# -----------------------------------------------------------------------------
# DERBIS_EDITORIAL_SP_DC=
# DERBIS_EDITORIAL_YTM_COOKIE=


# Android Release Signing
# -----------------------------------------------------------------------------
# DERBIS_KEYSTORE_BASE64=
# DERBIS_KEYSTORE_PASSWORD=
# DERBIS_KEY_ALIAS=
# DERBIS_KEY_PASSWORD=
