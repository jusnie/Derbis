{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/install",
      "destination": "/install.html"
    },
    {
      "source": "/ios",
      "destination": "/install.html"
    },
    {
      "source": "/t/:id",
      "destination": "/api/track?id=:id"
    },
    {
      "source": "/track/:id",
      "destination": "/api/track?id=:id"
    },
    {
      "source": "/jam/:code",
      "destination": "/api/jam?code=:code"
    },
    {
      "source": "/jam",
      "destination": "/api/jam"
    }
  ],
  "headers": [
    {
      "source": "/manifest.plist",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "git": {
    "deploymentEnabled": {
      "agent/validation-1.5.0": false
    }
  }
}
