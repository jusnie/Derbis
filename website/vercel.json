{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/Derbis.ipa",
      "destination": "/api/ipa"
    },
    {
      "source": "/Derbis.ipa.sha256",
      "destination": "/api/ipa-sha256"
    },
    {
      "source": "/t/:id",
      "destination": "/api/track?id=:id"
    },
    {
      "source": "/track/:id",
      "destination": "/api/track?id=:id"
    },
    {
      "source": "/jam/:code",
      "destination": "/api/jam?code=:code"
    },
    {
      "source": "/jam",
      "destination": "/api/jam"
    }
  ],
  "headers": [
    {
      "source": "/manifest.plist",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
